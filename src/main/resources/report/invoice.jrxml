  ($F{name} != null && !$F{name}.trim().isEmpty()) 
    ? $F{name} + "\n" 
    : ""
)+(
  ($F{type} != null && !$F{type}.trim().isEmpty()) 
    ? "ประเภท: " + $F{type} + "\n" 
    : ""
)
+
(
  ($F{capacity} != null && !$F{capacity}.trim().isEmpty()) 
    ? "ขนาดบรรจุ: " + $F{capacity} + "\n" 
    : ""
)
+
(
  ($F{spec} != null && !$F{spec}.trim().isEmpty()) 
    ? "สเปคงาน: " + $F{spec} 
    : ""
)]]></expression>
