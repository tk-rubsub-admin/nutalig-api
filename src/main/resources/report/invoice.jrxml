		<element kind="textField" uuid="824562a9-4fed-4f0f-b7cd-de1f4864363d" x="509" y="60" width="46" height="20" fontName="TH SarabunPSK" fontSize="12.0" pattern="#,##0.##;(#,##0.##)" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
			<paragraph lineSpacing="1_1_2" lineSpacingSize="2.0"/>
			<expression><![CDATA[$P{amount}]]></expression>
