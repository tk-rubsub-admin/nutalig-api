{
  "type": "flex",
  "altText": "${altText}",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "styles": {
      "header": {
        "backgroundColor": "#1F3F37"
      },
      "body": {
        "backgroundColor": "#F7F3EE"
      },
      "footer": {
        "backgroundColor": "#F7F3EE"
      }
    },
    "header": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "contents": [
        {
          "type": "text",
          "text": "แจ้งเตือนจากระบบ",
          "size": "sm",
          "color": "#D4C5BA"
        },
        {
          "type": "text",
          "text": "${title}",
          "weight": "bold",
          "size": "xl",
          "color": "#F7F3EE",
          "wrap": true,
          "margin": "sm"
        }
      ]
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "spacing": "md",
      "contents": [
        {
          "type": "text",
          "text": "รายละเอียด",
          "size": "sm",
          "weight": "bold",
          "color": "#925944"
        },
        {
          "type": "box",
          "layout": "vertical",
          "cornerRadius": "md",
          "paddingAll": "14px",
          "backgroundColor": "#D4C5BA",
          "borderWidth": "1px",
          "borderColor": "#925944",
          "contents": [
            {
              "type": "text",
              "text": "${detail}",
              "size": "sm",
              "color": "#30302F",
              "wrap": true
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "height": "sm",
          "color": "#1F3F37",
          "action": {
            "type": "uri",
            "label": "ดูรายละเอียด",
            "uri": "${detailUrl}"
          }
        },
        {
          "type": "text",
          "text": "NUTALIG | Strategic Packaging Partner",
          "size": "xs",
          "color": "#925944",
          "align": "center",
          "margin": "md"
        }
      ]
    }
  }
}
