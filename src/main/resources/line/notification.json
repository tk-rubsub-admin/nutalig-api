{
  "type": "flex",
  "altText": "${altText}",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "header": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "backgroundColor": "#1E3A5F",
      "contents": [
        {
          "type": "text",
          "text": "แจ้งเตือนจากระบบ",
          "size": "sm",
          "color": "#D8E6F3"
        },
        {
          "type": "text",
          "text": "${title}",
          "weight": "bold",
          "size": "xl",
          "color": "#FFFFFF",
          "wrap": true,
          "margin": "sm"
        }
      ]
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "spacing": "md",
      "contents": [
        {
          "type": "text",
          "text": "รายละเอียด",
          "size": "sm",
          "weight": "bold",
          "color": "#64748B"
        },
        {
          "type": "box",
          "layout": "vertical",
          "cornerRadius": "md",
          "paddingAll": "14px",
          "backgroundColor": "#F8FAFC",
          "contents": [
            {
              "type": "text",
              "text": "${detail}",
              "size": "sm",
              "color": "#111827",
              "wrap": true
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "20px",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "height": "sm",
          "color": "#2563EB",
          "action": {
            "type": "uri",
            "label": "ดูรายละเอียด",
            "uri": "${detailUrl}"
          }
        }
      ]
    }
  }
}
